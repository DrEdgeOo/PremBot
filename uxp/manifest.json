{
    "manifestVersion": 5,
    "id": "com.prembot.uxp",
    "name": "PremBot",
    "version": "0.2.0",
    "main": "index.html",
    "host": {
        "app": "premierepro",
        "minVersion": "25.6.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "primary",
            "label": { "default": "PremBot" },
            "minimumSize": { "width": 340, "height": 420 },
            "maximumSize": { "width": 1200, "height": 1200 },
            "preferredDockedSize": { "width": 440, "height": 640 }
        }
    ],
    "requiredPermissions": {
        "localFileSystem": "fullAccess",
        "clipboard": "readAndWrite",
        "network": {
            "domains": [
                "https://api.anthropic.com",
                "https://api.openai.com",
                "http://localhost:53210",
                "http://127.0.0.1:53210"
            ]
        }
    }
}
